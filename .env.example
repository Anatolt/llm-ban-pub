# scripts/configure.py generates fresh credentials; never commit .env.
LLMBAN_USERNAME=admin
LLMBAN_BIND=127.0.0.1
LLMBAN_PORT=8080
LLMBAN_COOKIE_SECURE=0
LLMBAN_PUBLIC_URL=''
# Your host directory containing the projects mounted under /workspaces.
LLMBAN_WORKSPACES=./workspaces
# Run agents with the owner UID/GID of those workspaces (never root).
LLMBAN_UID=1000
LLMBAN_GID=1000
# Select a provider/model supported by Pi and supply its key below.
LLMBAN_PI_PROVIDER=''
LLMBAN_PI_MODEL=''
ANTHROPIC_API_KEY=''
OPENAI_API_KEY=''
GEMINI_API_KEY=''
OPENROUTER_API_KEY=''
# Telegram requires both the compose profile and this explicit switch.
LLMBAN_TELEGRAM_ENABLED=0
LLMBAN_TELEGRAM_TOKEN=''
LLMBAN_TELEGRAM_CHAT_ID=''
LLMBAN_PASSWORD=''
